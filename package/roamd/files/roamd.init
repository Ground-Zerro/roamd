#!/bin/sh /etc/rc.common

USE_PROCD=1
START=80

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/roamd
	procd_set_param respawn
	procd_set_param termtimeout 10
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	ubus -t 3 call roamd reload 2>/dev/null || restart
}

service_triggers() {
	procd_add_reload_trigger "roamd" "wireless"
}
