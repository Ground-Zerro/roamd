msgstr "например, Home"

msgid "Encryption"
msgstr "Шифрование"

msgid "Only the modes that support fast roaming are offered."
msgstr "Предлагаются только режимы, поддерживающие быстрый роуминг."

msgid "WPA2 (compatible with everything)"
msgstr "WPA2 (совместим со всем)"

msgid "WPA2/WPA3 (recommended)"
msgstr "WPA2/WPA3 (рекомендуется)"

