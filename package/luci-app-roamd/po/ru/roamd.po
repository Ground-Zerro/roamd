msgstr "Создаётся сеть…"

msgid "Nothing has been changed."
msgstr "Изменения в систему не вносились."

msgid "This system has no hostapd with ubus support, so a roaming network cannot be created."
msgstr "В системе нет hostapd с поддержкой ubus — создать сеть с роумингом невозможно."

msgid "No wireless radios were found on this device."
msgstr "На устройстве не найдено ни одного радиоинтерфейса."

msgid "This device has radios of one band only. Roaming between 2.4 GHz and 5 GHz needs at least two radios on different bands."
msgstr "На устройстве есть радиоинтерфейсы только одного диапазона. Для роуминга между 2,4 ГГц и 5 ГГц нужно минимум два радиоинтерфейса разных диапазонов."

msgid "This hostapd build has no 802.11r support. Roaming will work through 802.11k and 802.11v, but transitions will be slower."
msgstr "Установленная сборка hostapd не поддерживает 802.11r. Роуминг будет работать через 802.11k и 802.11v, но переходы станут медленнее."

msgid "The following radios are currently disabled and will be switched on: %s."
msgstr "Следующие радиоинтерфейсы сейчас выключены и будут включены: %s."

msgid "The network name must be between 1 and 32 bytes long."
msgstr "Имя сети должно быть длиной от 1 до 32 байт."

msgid "The password must be between 8 and 63 characters long."
msgstr "Пароль должен быть длиной от 8 до 63 символов."

